# ═══════════════════════════════════════════════════════════════
#  Emanet Takip Sistemi - Ortam Ayarları
#  Bu dosyayı ".env" olarak kopyalayıp değerleri düzenleyin.
#  (Yani: bu dosyanın adını ".env" yapın)
# ═══════════════════════════════════════════════════════════════

# Sunucu portu (varsayılan: 3000)
PORT=3000

# Sunucunun dinleyeceği adres:
#   127.0.0.1  → Sadece bu bilgisayar (GÜVENLİ, varsayılan)
#   0.0.0.0    → Aynı ağdaki tüm cihazlar (tablet/telefon için, şifre şart!)
HOST=127.0.0.1

# Giriş şifresi. Boş bırakırsanız şifre koruması KAPALI olur.
# Şifre belirlerseniz tarayıcı ilk açılışta şifre sorar.
# Örnek: APP_PASSWORD=emanet2026
APP_PASSWORD=

# Sunucu ayağa kalkınca tarayıcıyı otomatik aç (baslat.bat bunu 1 yapar)
OPEN_BROWSER=1

# (Opsiyonel) Kendi Chrome/Edge yolunuzu elle belirtmek isterseniz:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# (Opsiyonel) WhatsApp bağlantısını tamamen kapatır. Sadece test/geliştirme içindir.
# WA_DISABLE=1
